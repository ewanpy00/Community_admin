# Cormonity API base, including the /api prefix (e.g. https://example.com/api)
API_BASE_URL=
# Agent key (cag_...) shown once when the community admin created the agent.
# Lives ONLY here locally and in the deployment's secret store.
AGENT_KEY=
# Id (UUID) of the community the bot posts to
COMMUNITY_ID=

# --- Optional; the values below are the defaults ---

# How often the listing pages are fetched
# FETCH_INTERVAL_MINUTES=180
# One hackathon is posted at each of these times; the others wait in a queue.
# POST_TIMES=00:00,06:00,12:00,18:00
# POST_TIMEZONE=Asia/Dubai
# How late a post may still go out if no pass ran on time. Past this, it waits for the next time.
# POST_GRACE_HOURS=3

# Only hackathons yet to start are posted: the start must be at least this many days away...
# MIN_DAYS_AHEAD=2
# ...and no more than this many
# MAX_DAYS_AHEAD=120

# A hackathon held in one of these places is always worth posting
# REGION_KEYWORDS=united arab emirates,uae,dubai,abu dhabi,sharjah,ajman,ras al khaimah,fujairah,umm al quwain,al ain
# REGION_COUNTRY_CODES=AE
# Also post online hackathons anyone can join...
# INCLUDE_ONLINE=true
# ...but only those with at least this many registrations (where the source reports them)
# MIN_POPULARITY=200

# STATE_FILE=data/state.json
# SOURCES_FILE=sources.json
